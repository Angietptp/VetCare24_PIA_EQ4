erDiagram
  PROPIETARIOS ||--o{ MASCOTAS : posee
  PROPIETARIOS ||--o{ CITAS : solicita
  MASCOTAS ||--o{ CITAS : recibe
  CITAS ||--|{ CITA_LINEAS : contiene
  SERVICIOS ||--o{ CITA_LINEAS : "se solicita en"
  MASCOTAS ||--o{ VACUNACIONES : recibe
  ESQUEMAS_VACUNACION ||--o{ VACUNACIONES : "define seguimiento por vacuna_clave"
  MASCOTAS |o--o{ EMERGENCIAS : presenta
  MASCOTAS ||--o{ NOTAS_CLINICAS : "tiene en su expediente"
  CITAS |o--o{ NOTAS_CLINICAS : "origina (opcional)"
  MASCOTAS ||--o{ HOSPITALIZACIONES : "es internada en"
  HOSPITALIZACIONES ||--o{ LECTURAS_MONITOREO : "hoja de monitoreo"
  MASCOTAS ||--o{ RECETAS : recibe
  RECETAS ||--|{ RECETA_MEDICAMENTOS : incluye
  MASCOTAS ||--o{ ORDENES_ESTUDIO : recibe
  CITAS ||--o| COBROS : "se cobra una vez"
  PROPIETARIOS { text propietario_id PK
    text nombre
    int activo
    int preferente }
  MASCOTAS { text mascota_id PK
    text propietario_id FK
    text nombre
    text especie
    text raza
    text sexo
    text fecha_nacimiento
    text peso_kg
    text alergias_json }
  SERVICIOS { text servicio_id PK
    text descripcion
    bigint precio_centavos
    int capacidad
    int habilitado }
  CITAS { text cita_id PK
    text propietario_id FK
    text mascota_id FK
    text fecha_solicitud
    text estado
    int autorizada
    int promocion_activa }
  CITA_LINEAS { text cita_id PK
    int posicion PK
    text servicio_id FK
    int cantidad }
  VACUNACIONES { text vacunacion_id PK
    text mascota_id FK
    text vacuna
    text vacuna_clave
    text fecha_aplicacion
    text lote }
  ESQUEMAS_VACUNACION { text vacuna_clave PK
    int frecuencia_dias
    int requiere_refuerzo
    int validado }
  EMERGENCIAS { text emergencia_id PK
    text mascota_id FK "opcional"
    text motivo
    text datos_paciente
    text estado
    text identificada_en
    text atendida_en }
  NOTAS_CLINICAS { text nota_id PK
    text mascota_id FK
    text cita_id FK "opcional"
    text diagnostico
    text indicaciones
    text registrada_en }
  HOSPITALIZACIONES { text hospitalizacion_id PK
    text mascota_id FK
    text motivo
    text estado
    text ingresada_en
    text alta_en
    text resumen_alta }
  LECTURAS_MONITOREO { text hospitalizacion_id PK
    int orden PK
    text registrada_en
    text observaciones
    text temperatura_c
    int frecuencia_cardiaca }
  RECETAS { text receta_id PK
    text mascota_id FK
    text cita_id FK "opcional"
    text registrada_en }
  RECETA_MEDICAMENTOS { text receta_id PK
    int orden PK
    text nombre
    text dosis
    text indicaciones }
  ORDENES_ESTUDIO { text orden_id PK
    text mascota_id FK
    text cita_id FK "opcional"
    text estudio
    text indicaciones
    text registrada_en }
  COBROS { text cobro_id PK
    text cita_id FK "unico"
    text mascota_id FK
    bigint total_centavos
    text metodo
    text cobrado_en }
  EVENTOS_DOMINIO { text evento
    text agregado_tipo
    text agregado_id
    text ocurrido_en
    text payload_json }
