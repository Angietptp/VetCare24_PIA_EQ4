# Copia este archivo como .env (cp .env.example .env). Docker Compose lo lee solo.
# 12-factor: toda la configuración sale del entorno; no versiones secretos reales.

# --- Docker Compose local ---
POSTGRES_USER=vetcare
POSTGRES_PASSWORD=vetcare_dev
POSTGRES_DB=vetcare24
APP_PORT=8000

# --- Despliegue en la nube (Render / Railway / Fly.io) ---
# La plataforma entrega DATABASE_URL de su PostgreSQL administrado y PORT.
# DATABASE_URL=postgresql://usuario:clave@host:5432/base
# PORT=8000
# DATA_DIR=/app/data/alumno
